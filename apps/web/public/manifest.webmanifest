{
  "name": "OpenKey — browser keyboard configurator",
  "short_name": "OpenKey",
  "description": "Open-source, local-first keyboard configurator. Talks to your keyboard over WebHID; no account, no telemetry.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0d0f13",
  "theme_color": "#0d0f13",
  "icons": [
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
