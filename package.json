{
  "name": "openkey",
  "version": "0.2.0",
  "private": true,
  "description": "OpenKey: open-source, local-first browser keyboard configurator with a modular protocol-adapter architecture.",
  "license": "MIT",
  "homepage": "https://github.com/BakulBd/openkey#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BakulBd/openkey.git"
  },
  "bugs": {
    "url": "https://github.com/BakulBd/openkey/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "openkey": "tsx tools/cli/src/main.ts",
    "openak820": "tsx tools/cli/src/main.ts",
    "inspect": "tsx tools/device-inspector/src/main.ts",
    "probe": "tsx tools/probe-device/src/main.ts",
    "packet-diff": "tsx tools/packet-diff/src/main.ts",
    "dev": "pnpm --filter @openkey/web dev",
    "build": "pnpm build:cli && pnpm build:web",
    "build:cli": "node tools/cli/build.mjs",
    "build:web": "pnpm --filter @openkey/web build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @openkey/web typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "node tools/e2e/smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@openkey/core": "workspace:^",
    "@openkey/devices": "workspace:^",
    "@openkey/hid": "workspace:^",
    "@openkey/hid-node": "workspace:^",
    "@openkey/protocols": "workspace:^",
    "@openkey/tft": "workspace:^",
    "@types/node": "^26.6.4",
    "@types/w3c-web-hid": "^1.0.7",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "playwright-core": "^1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ]
}
